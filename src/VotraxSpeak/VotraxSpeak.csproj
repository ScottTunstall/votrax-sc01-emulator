<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>VotraxSpeak</RootNamespace>
    <AssemblyName>VotraxSpeak</AssemblyName>
    <Version>1.1.0</Version>
    <Description>Speaks text through an emulation of the Votrax SC-01 speech chip, ported from MAME.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The XML documentation file exists for the analyzers; installed copies have no use for it. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The phoneme ROM is copyrighted firmware and is not part of the source tree.
         Put sc01a.bin in the repository's roms folder and they are copied next to the
         executable for local builds. They are never published, so they cannot end up in an installer. -->
    <None Include="..\..\roms\*.bin" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VotraxSpeak.Tests" />
  </ItemGroup>

</Project>
